<?xml version="1.0"?>
<sdf version="1.9">
  <model name="weed_small">
    <static>true</static>
    <link name="weed_link">
      <!-- 茎 -->
      <visual name="stem">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.008</radius><length>0.10</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.5 0.1 1</ambient>
          <diffuse>0.15 0.60 0.15 1</diffuse>
        </material>
      </visual>
      <!-- 葉 (上部) -->
      <visual name="leaf_top">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry>
          <sphere><radius>0.06</radius></sphere>
        </geometry>
        <material>
          <ambient>0.1 0.6 0.1 1</ambient>
          <diffuse>0.15 0.70 0.15 1</diffuse>
        </material>
      </visual>
      <!-- 葉 (横広がり) -->
      <visual name="leaf_wide">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.04</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.15 0.55 0.10 1</ambient>
          <diffuse>0.20 0.65 0.12 1</diffuse>
        </material>
      </visual>
      <!-- コリジョン (簡略化) -->
      <collision name="weed_collision">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.06</radius><length>0.12</length></cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
