<?xml version="1.0"?>
<!--
  road_shoulder.sdf
  路肩除草シミュレーション用ワールド (Gazebo Harmonic)

  座標系:
    X軸: 道路進行方向 (ロボット進行方向)
    Y軸: 道路幅方向  (Y>0 が路肩・Y<0 が対向車線側)
    Z軸: 鉛直上方向

  レイアウト (横断面):
    Y=-6  : 左路側帯外縁
    Y=-4  : 道路左端 (外側線)
    Y= 0  : 道路中央線
    Y=+4  : 道路右端 (外側線)
    Y=+4.5: 路肩内縁 (縁石)
    Y=+7  : 路肩外縁 (雑草帯)
    Y=+7.5: ガードレール
    Y=+9  : 法面開始

  路長: X=-20m 〜 X=+20m (全長40m)
-->
<sdf version="1.9">
  <world name="road_shoulder">

    <!-- ======== Gazebo Harmonicシステムプラグイン ======== -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- ======== 物理設定 ======== -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ======== 太陽光 ======== -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.1 -0.9</direction>
    </light>

    <!-- ======== 地面 (全体) ======== -->
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_col">
          <geometry>
            <plane><normal>0 0 1</normal><size>60 30</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="ground_vis">
          <geometry>
            <plane><normal>0 0 1</normal><size>60 30</size></plane>
          </geometry>
          <!-- 草地・土色 -->
          <material>
            <ambient>0.25 0.35 0.15 1</ambient>
            <diffuse>0.30 0.45 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======== 舗装道路面 (Y=-4 〜 Y=+4, X=-20〜+20) ======== -->
    <model name="road_surface">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="road_link">
        <collision name="c">
          <geometry><box><size>40 8 0.01</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>40 8 0.01</size></box></geometry>
          <!-- アスファルト色 -->
          <material>
            <ambient>0.28 0.28 0.28 1</ambient>
            <diffuse>0.32 0.32 0.32 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======== 道路中央線 (黄色破線) ======== -->
    <model name="center_line_1"><static>true</static><pose>-15 0 0.01 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>4 0.15 0.005</size></box></geometry>
      <material><ambient>0.9 0.8 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse></material></visual></link></model>
    <model name="center_line_2"><static>true</static><pose>-9 0 0.01 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>4 0.15 0.005</size></box></geometry>
      <material><ambient>0.9 0.8 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse></material></visual></link></model>
    <model name="center_line_3"><static>true</static><pose>-3 0 0.01 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>4 0.15 0.005</size></box></geometry>
      <material><ambient>0.9 0.8 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse></material></visual></link></model>
    <model name="center_line_4"><static>true</static><pose>3 0 0.01 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>4 0.15 0.005</size></box></geometry>
      <material><ambient>0.9 0.8 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse></material></visual></link></model>
    <model name="center_line_5"><static>true</static><pose>9 0 0.01 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>4 0.15 0.005</size></box></geometry>
      <material><ambient>0.9 0.8 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse></material></visual></link></model>
    <model name="center_line_6"><static>true</static><pose>15 0 0.01 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>4 0.15 0.005</size></box></geometry>
      <material><ambient>0.9 0.8 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse></material></visual></link></model>

    <!-- ======== 道路外側線 (白実線) 右側 Y=+4 ======== -->
    <model name="edge_line_right">
      <static>true</static>
      <pose>0 4 0.01 0 0 0</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>40 0.15 0.005</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ======== 道路外側線 (白実線) 左側 Y=-4 ======== -->
    <model name="edge_line_left">
      <static>true</static>
      <pose>0 -4 0.01 0 0 0</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>40 0.15 0.005</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ======== 路肩面 (Y=+4 〜 +7.5, 砂利/土色) ======== -->
    <model name="shoulder_surface">
      <static>true</static>
      <pose>0 5.75 0.003 0 0 0</pose>
      <link name="shoulder_link">
        <collision name="c">
          <geometry><box><size>40 3.5 0.006</size></box></geometry>
          <surface>
            <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>40 3.5 0.006</size></box></geometry>
          <!-- 路肩の砂利・土色 -->
          <material>
            <ambient>0.55 0.45 0.30 1</ambient>
            <diffuse>0.65 0.52 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======== 縁石 (curb) Y=+4 〜 +4.5 ======== -->
    <model name="curb_right">
      <static>true</static>
      <pose>0 4.25 0.05 0 0 0</pose>
      <link name="curb_link">
        <collision name="c">
          <geometry><box><size>40 0.15 0.10</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>40 0.15 0.10</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ======== ガードレール (Y=+7.5) ======== -->
    <!-- 支柱 (2m間隔) -->
    <model name="guardrail_post_1"><static>true</static><pose>-18 7.5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.10 0.10 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.10 0.10 1.0</size></box></geometry>
      <material><ambient>0.7 0.7 0.7 1</ambient></material></visual></link></model>
    <model name="guardrail_post_2"><static>true</static><pose>-14 7.5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.10 0.10 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.10 0.10 1.0</size></box></geometry>
      <material><ambient>0.7 0.7 0.7 1</ambient></material></visual></link></model>
    <model name="guardrail_post_3"><static>true</static><pose>-10 7.5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.10 0.10 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.10 0.10 1.0</size></box></geometry>
      <material><ambient>0.7 0.7 0.7 1</ambient></material></visual></link></model>
    <model name="guardrail_post_4"><static>true</static><pose>-6 7.5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.10 0.10 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.10 0.10 1.0</size></box></geometry>
      <material><ambient>0.7 0.7 0.7 1</ambient></material></visual></link></model>
    <model name="guardrail_post_5"><static>true</static><pose>-2 7.5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.10 0.10 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.10 0.10 1.0</size></box></geometry>
      <material><ambient>0.7 0.7 0.7 1</ambient></material></visual></link></model>
    <model name="guardrail_post_6"><static>true</static><pose>2 7.5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.10 0.10 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.10 0.10 1.0</size></box></geometry>
      <material><ambient>0.7 0.7 0.7 1</ambient></material></visual></link></model>
    <model name="guardrail_post_7"><static>true</static><pose>6 7.5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.10 0.10 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.10 0.10 1.0</size></box></geometry>
      <material><ambient>0.7 0.7 0.7 1</ambient></material></visual></link></model>
    <model name="guardrail_post_8"><static>true</static><pose>10 7.5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.10 0.10 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.10 0.10 1.0</size></box></geometry>
      <material><ambient>0.7 0.7 0.7 1</ambient></material></visual></link></model>
    <model name="guardrail_post_9"><static>true</static><pose>14 7.5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.10 0.10 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.10 0.10 1.0</size></box></geometry>
      <material><ambient>0.7 0.7 0.7 1</ambient></material></visual></link></model>
    <model name="guardrail_post_10"><static>true</static><pose>18 7.5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.10 0.10 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.10 0.10 1.0</size></box></geometry>
      <material><ambient>0.7 0.7 0.7 1</ambient></material></visual></link></model>

    <!-- ガードレール ビーム (水平梁) -->
    <model name="guardrail_beam">
      <static>true</static>
      <pose>0 7.5 0.75 0 0 0</pose>
      <link name="beam_link">
        <collision name="c">
          <geometry><box><size>40 0.08 0.15</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>40 0.08 0.15</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ======== GUIカメラ初期視点 ======== -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.6 0.8 1.0</background_color>
        <!-- 斜め上空から俯瞰: 道路方向 (X軸) に沿って見下ろす -->
        <camera_pose>-20 -5 15 0 0.9 0.3</camera_pose>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu"/>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="TransformControl" name="Transform control"/>
      <plugin filename="Shapes" name="Shapes"/>
      <plugin filename="KeyPublisher" name="Key publisher"/>
    </gui>

  </world>
</sdf>
