<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ===== 共通パラメータ ===== -->
  <xacro:property name="PI" value="3.14159265358979"/>

  <xacro:property name="base_length" value="0.45"/>
  <xacro:property name="base_width"  value="0.35"/>
  <xacro:property name="base_height" value="0.15"/>

  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width"  value="0.05"/>
  <xacro:property name="track_width"  value="0.40"/>

  <!-- ===== 材質定義 ===== -->
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="white">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.1 0.6 0.1 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>

  <!-- ===== ホイールマクロ ===== -->
  <xacro:macro name="wheel_macro" params="prefix side x y">
    <link name="${prefix}/base_link_${side}_wheel">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia
          ixx="0.00083" ixy="0.0" ixz="0.0"
          iyy="0.00083" iyz="0.0"
          izz="0.00160"/>
      </inertial>
    </link>

    <joint name="${prefix}/${side}_wheel_joint" type="continuous">
      <parent link="${prefix}/base_link"/>
      <child  link="${prefix}/base_link_${side}_wheel"/>
      <origin xyz="${x} ${y} 0.0" rpy="${PI/2} 0.0 0.0"/>
      <axis xyz="0 0 -1"/>
      <dynamics damping="0.1"/>
    </joint>

    <gazebo reference="${prefix}/base_link_${side}_wheel">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <!-- ===== 差動駆動台車マクロ ===== -->
  <xacro:macro name="diff_drive_base" params="robot_name color">

    <!-- base_footprint: 地面接地点 -->
    <link name="${robot_name}/base_footprint"/>

    <joint name="${robot_name}/base_footprint_joint" type="fixed">
      <parent link="${robot_name}/base_footprint"/>
      <child  link="${robot_name}/base_link"/>
      <origin xyz="0.0 0.0 ${wheel_radius}" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- 車体本体 -->
    <link name="${robot_name}/base_link">
      <visual>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
        <material name="${color}"/>
      </visual>
      <collision>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="8.0"/>
        <inertia
          ixx="0.0843" ixy="0.0" ixz="0.0"
          iyy="0.1408" iyz="0.0"
          izz="0.2108"/>
      </inertial>
    </link>

    <!-- 4輪配置 -->
    <xacro:wheel_macro prefix="${robot_name}" side="left_front"
      x="${base_length/2 - 0.08}" y="${track_width/2}"/>
    <xacro:wheel_macro prefix="${robot_name}" side="right_front"
      x="${base_length/2 - 0.08}" y="${-track_width/2}"/>
    <xacro:wheel_macro prefix="${robot_name}" side="left_rear"
      x="${-(base_length/2 - 0.08)}" y="${track_width/2}"/>
    <xacro:wheel_macro prefix="${robot_name}" side="right_rear"
      x="${-(base_length/2 - 0.08)}" y="${-track_width/2}"/>

    <!-- 差動駆動プラグイン (Gazebo Harmonic) -->
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>${robot_name}/left_front_wheel_joint</left_joint>
        <right_joint>${robot_name}/right_front_wheel_joint</right_joint>
        <wheel_separation>${track_width}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <odom_publish_frequency>20</odom_publish_frequency>
        <topic>/${robot_name}/cmd_vel</topic>
        <odom_topic>/${robot_name}/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>${robot_name}/odom</frame_id>
        <child_frame_id>${robot_name}/base_footprint</child_frame_id>
        <max_linear_acceleration>1.0</max_linear_acceleration>
      </plugin>
    </gazebo>

    <!-- ジョイント状態パブリッシャー -->
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>/${robot_name}/joint_states</topic>
        <joint_name>${robot_name}/left_front_wheel_joint</joint_name>
        <joint_name>${robot_name}/right_front_wheel_joint</joint_name>
        <joint_name>${robot_name}/left_rear_wheel_joint</joint_name>
        <joint_name>${robot_name}/right_rear_wheel_joint</joint_name>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
