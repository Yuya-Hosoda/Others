<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
    RGBDカメラマクロ (Intel RealSense D435相当)
    params:
      prefix  - カメラ識別名 (例: robot1_front)
      parent  - 取付親リンク名
      xyz     - 取付位置 "x y z"
      rpy     - 取付姿勢 "roll pitch yaw"
      robot   - ロボット名 (トピック名プレフィックス用)
  -->
  <xacro:macro name="realsense_d435" params="prefix parent xyz rpy robot">

    <joint name="${prefix}/rgbd_joint" type="fixed">
      <parent link="${parent}"/>
      <child  link="${prefix}/rgbd_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- カメラ筐体 -->
    <link name="${prefix}/rgbd_link">
      <visual>
        <geometry>
          <box size="0.025 0.090 0.025"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.025 0.090 0.025"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.072"/>
        <inertia
          ixx="0.0000154" ixy="0.0" ixz="0.0"
          iyy="0.0000036" iyz="0.0"
          izz="0.0000172"/>
      </inertial>
    </link>

    <!-- Optical frame: ROS標準 (Z前・X右・Y下) への変換 -->
    <joint name="${prefix}/rgbd_optical_joint" type="fixed">
      <parent link="${prefix}/rgbd_link"/>
      <child  link="${prefix}/rgbd_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
    </joint>
    <link name="${prefix}/rgbd_optical_frame"/>

    <!-- Gazebo Harmonic RGBDセンサ定義 -->
    <gazebo reference="${prefix}/rgbd_link">
      <sensor name="${prefix}_rgbd_sensor" type="rgbd_camera">
        <gz_frame_id>${prefix}/rgbd_optical_frame</gz_frame_id>
        <update_rate>30</update_rate>
        <topic>/${robot}/rgbd/${prefix}</topic>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
